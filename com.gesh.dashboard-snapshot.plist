<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gesh.dashboard-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/georgigaydarov/Projects/gesh-project/refresh_dashboard_snapshot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/georgigaydarov/Projects/gesh-project</string>

    <!-- Fire every 30 min around the clock; the wrapper's market-hours guard makes
         off-hours ticks a cheap no-op. Primary path is LLM-free (fetch_snapshot_direct.py).
         RunAtLoad refreshes once on load. -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/gesh_dashboard_snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gesh_dashboard_snapshot.log</string>
</dict>
</plist>
