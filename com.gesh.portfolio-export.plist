<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gesh.portfolio-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/georgigaydarov/Projects/gesh-project/venv/bin/python3</string>
        <string>/Users/georgigaydarov/Projects/gesh-project/export_portfolio.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/georgigaydarov/Projects/gesh-project</string>

    <key>StartCalendarInterval</key>
    <array>
        <!-- 08:25 AM — before pre-market autopilot scan -->
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <!-- 10:25 AM — 5 minutes before daily analysis -->
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <!-- 15:50 PM — before EOD risk check -->
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>50</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/gesh_portfolio_export.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/gesh_portfolio_export.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
