<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gesh.signal-alerts</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/georgigaydarov/Projects/gesh-project/run_signal_alerts.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/georgigaydarov/Projects/gesh-project</string>

    <!-- Tick every 30 min; the SCRIPT decides (schedule_gate.py, America/New_York):
         Mon-Fri from 11:05 ET, once per ET date, with catch-up after sleep/wake.
         The old StartCalendarInterval fired in the Mac's LOCAL timezone (EEST here
         = 04:05 ET) and silently skipped runs missed while asleep (Codex P1). -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/gesh_signal_alerts.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gesh_signal_alerts.log</string>
</dict>
</plist>
