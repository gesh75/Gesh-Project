<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gesh.weekly-note</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/georgigaydarov/Projects/gesh-project/run_weekly_note.sh</string>
        <string>--send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/georgigaydarov/Projects/gesh-project</string>

    <!-- Hourly tick; weekly_note.py gates on America/New_York (rule #56: never pin an ET
         wall-clock in a host-local calendar). Mailing the whole list also needs
         GESH_MAIL_POSTAL_ADDRESS in .env, otherwise it refuses and exits cleanly. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/gesh_weekly_note.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gesh_weekly_note.log</string>
</dict>
</plist>
