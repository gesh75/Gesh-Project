<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gesh.weekly-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/georgigaydarov/Projects/gesh-project/run_weekly_digest.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/georgigaydarov/Projects/gesh-project</string>

    <!-- Fridays 17:15 local — after market close, end-of-week wrap. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>17</integer>
        <key>Minute</key>
        <integer>15</integer>
        <key>Weekday</key>
        <integer>5</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/gesh_weekly_digest.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gesh_weekly_digest.log</string>
</dict>
</plist>
