<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gesh.weekly-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/georgigaydarov/Projects/gesh-project/run_weekly_digest.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/georgigaydarov/Projects/gesh-project</string>

    <!-- Tick every 30 min; the SCRIPT decides (schedule_gate.py, America/New_York):
         Friday from 17:15 ET with the whole weekend as catch-up, once per ISO week.
         The old Friday-17:15 LOCAL calendar trigger meant 10:15 ET on this EEST
         host, and vanished entirely when the Mac slept through it — the digest
         had literally never run (Codex P1). -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/gesh_weekly_digest.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gesh_weekly_digest.log</string>
</dict>
</plist>
