<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@color/card" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI DEEP ANALYSIS" android:textColor="@color/accent"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/tvModelBadge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="◈ Snowflake · Fair Value · Predictions"
                android:textColor="@color/purple" android:textSize="10sp"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunAnalysis"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="▶ Run Deep Analysis"
            android:textSize="10sp"
            app:backgroundTint="@color/accent"
            android:textColor="@color/black"
            app:cornerRadius="5dp"/>
    </LinearLayout>

    <!-- Progress / status -->
    <ProgressBar android:id="@+id/progressBar" android:layout_width="match_parent"
        android:layout_height="3dp" style="?android:attr/progressBarStyleHorizontal"
        android:indeterminate="true" android:progressTint="@color/accent"
        android:visibility="gone"/>

    <TextView android:id="@+id/tvStatusMsg" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="14dp"
        android:textColor="@color/muted" android:textSize="12sp"
        android:gravity="center" android:visibility="gone"/>

    <!-- Scrollable content (shown after analysis runs) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:padding="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Portfolio Intelligence Card -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/border" app:strokeWidth="1dp" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PORTFOLIO INTELLIGENCE" android:textColor="@color/accent"
                        android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <!-- Score + verdict row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView android:id="@+id/tvPortfolioScore" android:text="—"
                            android:textColor="@color/accent" android:textSize="40sp"
                            android:textStyle="bold" android:layout_width="64dp"
                            android:layout_height="wrap_content" android:gravity="center"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                            <TextView android:id="@+id/tvPortfolioVerdict"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/text" android:textSize="13sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvPortfolioType"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginTop="4dp" >
                                <TextView android:id="@+id/tvRiskScore"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Risk: —"
                                    android:textColor="@color/yellow" android:textSize="11sp" android:textStyle="bold"
                                    android:layout_marginEnd="12dp"/>
                                <TextView android:id="@+id/tvDiversification"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Diversification: —"
                                    android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Score bar -->
                    <ProgressBar android:id="@+id/scoreProgressBar" android:layout_width="match_parent"
                        android:layout_height="8dp" style="?android:attr/progressBarStyleHorizontal"
                        android:progress="0" android:max="100" android:layout_marginBottom="12dp"
                        android:progressBackgroundTint="@color/border" android:progressTint="@color/accent"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MARKET CONTEXT" android:textColor="@color/accent"
                        android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_marginBottom="5dp"/>
                    <TextView android:id="@+id/tvMarketContext"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/muted" android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" android:layout_marginBottom="12dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PORTFOLIO RISKS" android:textColor="@color/accent"
                        android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout android:id="@+id/llPortfolioRisks" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginBottom="12dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RECOMMENDATIONS" android:textColor="@color/accent"
                        android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout android:id="@+id/llRecommendations" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stock Cards container -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HOLDINGS — SNOWFLAKE ANALYSIS" android:textColor="@color/muted"
                android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
            <LinearLayout android:id="@+id/llStockCards" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Idle placeholder (shown before first run) -->
    <LinearLayout android:id="@+id/placeholder" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical" android:padding="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="◈" android:textColor="@color/border" android:textSize="40sp"
            android:gravity="center" android:layout_marginBottom="14dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AI Portfolio Intelligence"
            android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Snowflake scores · Fair value · Risk/reward · 3M &amp; 12M predictions"
            android:textColor="@color/muted" android:textSize="12sp" android:gravity="center"
            android:lineSpacingMultiplier="1.5"/>
    </LinearLayout>
</LinearLayout>
