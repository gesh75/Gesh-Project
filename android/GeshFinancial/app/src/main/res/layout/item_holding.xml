<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="center_vertical"
    android:background="@color/card">
    <TextView android:id="@+id/tvSymbol" android:layout_width="60dp" android:layout_height="wrap_content"
        android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvQty" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/muted" android:textSize="11sp"
        android:gravity="end"/>
    <TextView android:id="@+id/tvAvgCost" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.2" android:textColor="@color/text" android:textSize="11sp"
        android:gravity="end"/>
    <TextView android:id="@+id/tvLastPrice" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.2" android:textColor="@color/text" android:textSize="11sp"
        android:gravity="end"/>
    <TextView android:id="@+id/tvEquity" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.3" android:textColor="@color/text" android:textSize="11sp"
        android:gravity="end" android:textStyle="bold"/>
    <TextView android:id="@+id/tvAlloc" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="0.8" android:textColor="@color/muted" android:textSize="11sp"
        android:gravity="end"/>
    <TextView android:id="@+id/tvChange" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/green" android:textSize="11sp"
        android:gravity="end" android:textStyle="bold"/>
</LinearLayout>
