# ── Robinhood Account ─────────────────────────────────────────────────────────
# Your Robinhood login credentials (MFA supported)
ROBINHOOD_USER=your_robinhood_email@example.com
ROBINHOOD_PASS=your_robinhood_password

# ── Anthropic Claude API (REQUIRED) ───────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Accepted aliases: sonnet, haiku. Exact supported IDs are also accepted.
CLAUDE_MODEL=sonnet
CLAUDE_SCREENER_MODEL=haiku
# Bound a single network attempt. Retry policy is implemented and recorded by llm_gateway.
GESH_LLM_TIMEOUT_SECONDS=240
# Includes the first attempt; values above 3 are rejected by llm_gateway.
GESH_LLM_MAX_ATTEMPTS=3

# ── Google Gemini AI (OPTIONAL) ───────────────────────────────────────────────
# Free tier available at: https://aistudio.google.com/app/apikey
# Enables: batch news sentiment + second opinions on strong signals
# GEMINI_API_KEY=AIza...

# ── Finnhub News (OPTIONAL) ───────────────────────────────────────────────────
# Free tier: 60 calls/min — https://finnhub.io
# Enhances news sentiment quality when set
# FINNHUB_API_KEY=your_finnhub_key

# ── Telegram Alerts (OPTIONAL) ────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather, get your chat_id from @userinfobot
# TELEGRAM_BOT_TOKEN=123456789:ABC...
# TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_ALERTS=true

# ── FRED Macro Data (OPTIONAL) ────────────────────────────────────────────────
# Free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Improves Fed rate / yield curve accuracy in macro node
# FRED_API_KEY=your_fred_key

# ── Trading Safety Settings ───────────────────────────────────────────────────
# NEVER change PAPER_MODE to false without weeks of profitable paper testing
PAPER_MODE=true
REQUIRE_APPROVAL=true
KILL_SWITCH_PATH=~/.gesh/KILL
MAX_POSITION_PCT=0.02
MAX_DAILY_LOSS_PCT=0.01
MAX_ORDERS_PER_DAY=3
MIN_CASH_BUFFER_USD=500
MIN_CONFIDENCE=0.75
MAX_PRICE_AGE_SECONDS=300
PAPER_CASH_USD=100000

# ── API / Spend Protection (CRITICAL) ─────────────────────────────────────────
# Required for mutating endpoints and customer spend surfaces. Generate:
# python -c "import secrets; print('GESH_API_KEY=' + secrets.token_urlsafe(32))"
GESH_API_KEY=

# ── Reddit (for trading repo sentiment; OPTIONAL) ─────────────────────────────
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USER_AGENT=gesh-trading/1.0

# ── gesh-core (for CI / dev when using private dep) ───────────────────────────
# GESH_CORE_PAT=ghp_...   # fine-grained PAT with read on gesh75/gesh-core

# ── Decision Ledger (Phase 4B) ────────────────────────────────────────────────
# Stable non-secret tenant identifier for ledger recording.
# Required for associating daily analysis decisions with a tenant.
# Never contains credentials, tokens, or secrets.
# Blank or missing OWNER_TENANT_ID causes a non-fatal skip (no default invented).
OWNER_TENANT_ID=

